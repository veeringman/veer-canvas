# Extra safety if distro nginx rotate is missing/misconfigured.
# Installed to /etc/logrotate.d/veercanvas-nginx
/var/log/nginx/*.log {
  daily
  missingok
  rotate 14
  compress
  delaycompress
  notifempty
  create 0640 www-data adm
  sharedscripts
  postrotate
    if [ -f /run/nginx.pid ]; then
      kill -USR1 "$(cat /run/nginx.pid)"
    fi
  endscript
}
