# Gmail SMTP for HBC Sanyard OTP (do NOT commit this file with a real password).
# Create a Google App Password: https://myaccount.google.com/apppasswords
# (Google Account → Security → 2-Step Verification → App passwords)

RWA_SMTP_PROVIDER=gmail
RWA_SMTP_HOST=smtp.gmail.com
RWA_SMTP_PORT=587
RWA_SMTP_USER=vij.ksh@gmail.com
RWA_SMTP_FROM=vij.ksh@gmail.com
RWA_SMTP_PASS=your-16-char-app-password-here
RWA_OTP_TTL=600

# Optional: portal super-admin password login (defaults: admin / Admin15@8)
# RWA_SUPERADMIN_USER=admin
# RWA_SUPERADMIN_PASSWORD=change-me
# RWA_SUPERADMIN_RESET=1

# Phase-1 ops alerts (backup failure, disk/memory/load, service down). Defaults to RWA_SMTP_FROM.
# BACKUP_ALERT_TO=you@example.com
# Optional vitals thresholds (also set in cron env if needed):
# DISK_WARN_PCT=20
# DISK_CRIT_PCT=10
# MEM_WARN_PCT=15
# MEM_CRIT_PCT=8
