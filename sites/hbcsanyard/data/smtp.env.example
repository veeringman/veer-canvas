# Gmail SMTP for Housing Colony Sanyard (OTP, alerts, ops mail).
# Do NOT commit this file with a real password.
# Create a Google App Password: https://myaccount.google.com/apppasswords
# (Google Account → Security → 2-Step Verification → App passwords)

RWA_SMTP_PROVIDER=gmail
RWA_SMTP_HOST=smtp.gmail.com
RWA_SMTP_PORT=587
RWA_SMTP_USER=housingcolonysanyard@gmail.com
RWA_SMTP_FROM=housingcolonysanyard@gmail.com
RWA_SMTP_PASS=your-16-char-app-password-here
RWA_OTP_TTL=600
# Portal login cookie / DB session lifetime in seconds (default ~10 years = until Sign out).
# RWA_SESSION_TTL=315360000

# Optional: portal super-admin password login (defaults: admin / Admin15@8)
# RWA_SUPERADMIN_USER=admin
# RWA_SUPERADMIN_PASSWORD=change-me
# RWA_SUPERADMIN_RESET=1

# Ops alerts (backup failure, disk/memory/load, service down). Defaults to RWA_SMTP_FROM.
BACKUP_ALERT_TO=housingcolonysanyard@gmail.com
BACKUP_RETAIN_DAYS=7
# Optional vitals thresholds (also set in cron env if needed):
# DISK_WARN_PCT=20
# DISK_CRIT_PCT=10
# MEM_WARN_PCT=15
# MEM_CRIT_PCT=8

# Google Drive off-box backup — see data/drive.env.example (enable in Super admin → Settings).
# DRIVE_ENABLED=1
# DRIVE_FOLDER_ID=

# Optional: dedicated HMAC secret for portal PDF attestation (No Dues / cash notes).
# If unset, the app falls back to VEERCANVAS_ADMIN_SECRET from the systemd unit.
# VEERCANVAS_ATTEST_SECRET=long-random-string-here
