# Google Drive off-box backup (Phase 2).
# Do NOT commit real credentials. Preserve data/drive-sa.json on the server (chmod 600).
#
# Setup:
# 1. Google Cloud Console → enable Drive API → Service account → JSON key
# 2. Save JSON as data/drive-sa.json on the server
# 3. In Drive (housingcolonysanyard@gmail.com), create folder "Housing Colony Sanyard Backups"
# 4. Share that folder with the service account email (Editor)
# 5. Paste the folder ID from the Drive URL below and set DRIVE_ENABLED=1
# 6. Or enable from Super admin → Platform settings → Backups

DRIVE_ENABLED=0
DRIVE_FOLDER_ID=
# Personal Gmail: use OAuth token (data/drive-token.json) — see authorize-drive.py
# Shared Drive only: service account JSON (data/drive-sa.json)
GOOGLE_APPLICATION_CREDENTIALS=/var/www/hbcsanyard.veerlabs.solutions/data/drive-sa.json
DRIVE_TOKEN_JSON=/var/www/hbcsanyard.veerlabs.solutions/data/drive-token.json
# Keep this many dated backup tarballs on Drive (latest is always updated too)
DRIVE_RETAIN_DAYS=14
