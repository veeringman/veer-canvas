# Google Wallet for vehicle / gate passes (Android).
# Do NOT commit google-wallet-sa.json or this file with real IDs.
#
# Free Google setup (no Apple Developer fee):
# 1. Google Cloud Console → new or existing project → enable “Google Wallet API”
# 2. Create a service account → Keys → JSON. Save as data/google-wallet-sa.json (chmod 600)
# 3. pay.google.com/business/console → Google Wallet API → get an Issuer ID
#    (Google reviews new issuers; demo mode works while you wait)
# 4. In the Wallet console, add the service account email as a user with Developer access
# 5. Fill the values below, set GOOGLE_WALLET_ENABLED=1, restart the site
# 6. Android phones then see “Add to Google Wallet” on active passes

GOOGLE_WALLET_ENABLED=0
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_JSON=/var/www/hbcsanyard.veerlabs.solutions/data/google-wallet-sa.json
GOOGLE_WALLET_CLASS_SUFFIX=sanyard_vehicle
GOOGLE_WALLET_ORG=Himuda Housing Colony Sanyard
GOOGLE_WALLET_ORIGINS=https://housingcolonysanyard.in,https://www.housingcolonysanyard.in,https://hbcsanyard.veerlabs.solutions
