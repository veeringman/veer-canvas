# Optional LLM for the private RWA Assistant (RAG still works without this).
# Prefer OpenAI-compatible APIs. Do NOT commit real keys.
#
# RWA_AI_API_KEY=sk-...
# RWA_AI_BASE_URL=https://api.openai.com/v1
# RWA_AI_MODEL=gpt-4o-mini
# RWA_AI_EMBED_MODEL=text-embedding-3-small
#
# Veer AI Rust sidecar (BM25 b=0.78 + MMR). Built on deploy for hbcsanyard.
# VEER_AI_URL=http://127.0.0.1:8095
# VEER_AI_RAG=1
# VEER_AI_RAG_TIMEOUT_MS=1200
# VEER_AI_EMBED=1
#
# Corpus includes: Directory, Notices, Info Centre, Works, Campaigns, Marketplace,
# Proceedings, Parking guides, bank/UPI, FAQ, plus the signed-in resident's own records.
#
# Retrieval (EC2-safe): Veer AI BM25 + hashed n-gram mini-embeddings + MMR, then
# passage mining so answers use short topical spans (not full unrelated paragraphs).
# Without a key the assistant uses extractive answers.
# With a key: LLM answers + optional OpenAI embedding hybrid re-rank of BM25/ngram hits.
# Without the sidecar it falls back to Python lexical retrieval.
#
# Templates → Write a document — eGenie + Syntheon on the *separate* AI EC2
# (not 127.0.0.1 on the housingcolonysanyard host).
# EGENIE_URL=https://egenie.veerlabs.solutions
# EGENIE_API_KEY=
# EGENIE_TIMEOUT_MS=180000
# SYNTHEON_URL=https://syntheon.veerlabs.solutions
# SYNTHEON_API_KEY=
# SYNTHEON_TIMEOUT_MS=180000
# Set EGENIE_ENABLED=0 or SYNTHEON_ENABLED=0 to skip a service (LLM/RAG still drafts).
