# Web Push VAPID keys for HBC Sanyard (do NOT commit real keys).
# On first portal boot the server generates keys into data/vapid.env if missing.
# Redeploy preserves an existing vapid.env (same pattern as smtp.env).

# Keys are generated automatically on first portal boot if missing.
# RWA_VAPID_PUBLIC_KEY=
# RWA_VAPID_PRIVATE_KEY=
# mailto: contact for push service (defaults to RWA_SMTP_FROM when unset)
# RWA_VAPID_SUBJECT=mailto:you@example.com
