# Apple Wallet for vehicle / gate passes.
# Do NOT commit Certificates.p12 or this file with a real password.
#
# One-time Apple setup (Apple Developer Program, ~$99/year):
# 1. developer.apple.com → Certificates, Identifiers & Profiles → Identifiers
#    → Pass Type IDs → New. Example: pass.in.housingcolonysanyard.vehicle
# 2. Create a Pass Type ID certificate for that identifier, download it,
#    install in Keychain, then export as Certificates.p12 (include private key).
# 3. Copy the .p12 onto the server (chmod 600) and fill the values below.
# 4. Restart veercanvas-admin-hbcsanyard. Active passes then show
#    “Add to iPhone Wallet” in Pass · Your passes and on the gate-pass screen.
#
# WWDR intermediate is bundled at assets/wallet/AppleWWDRCAG4.cer.

APPLE_WALLET_ENABLED=0
APPLE_WALLET_PASS_TYPE_ID=pass.in.housingcolonysanyard.vehicle
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_ORG=Himuda Housing Colony Sanyard
APPLE_WALLET_P12=/var/www/hbcsanyard.veerlabs.solutions/data/apple-wallet/Certificates.p12
APPLE_WALLET_P12_PASSWORD=

# Optional: lock-screen relevance when near the colony
# APPLE_WALLET_LAT=
# APPLE_WALLET_LNG=
# APPLE_WALLET_RELEVANT_TEXT=Sanyard vehicle pass
# APPLE_WALLET_MAX_DISTANCE=1500
