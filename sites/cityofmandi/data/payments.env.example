# City of Mandi commerce payments (optional).
# Copied to data/payments.env on first deploy; edit on the server (never commit secrets).

# Razorpay live/test keys — when both are set, checkout uses Razorpay Checkout.js
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# When Razorpay keys are empty, demo mode lets merchants activate packs
# and customers mark orders paid without a gateway (for smoke / staging).
HUB_PAYMENTS_DEMO=1

# Optional UPI handle shown when online pay is off (manual settlement)
HUB_UPI_VPA=
HUB_UPI_NAME=City of Mandi
